# ── Quick start ──────────────────────────────────────────────────────────────
#
# Copy this file to .env and edit values, then:
#   cp .env.example .env
#
# Core only (OCR, no AI):
#   docker compose up
#
# With AI assistance – preferred: set COMPOSE_PROFILES below, then:
#   docker compose up
#
# With AI assistance – CLI alternative (overrides COMPOSE_PROFILES):
#   docker compose --profile ai up
#
# ── Portainer / GitOps note ───────────────────────────────────────────────────
# When deploying through Portainer (or any system that reads environment
# variables instead of CLI flags), set COMPOSE_PROFILES=ai in your stack
# environment to start the AI services automatically.  Leave it empty or
# omit it entirely to run core-only (OCR) mode.

# Application port (default: 8000)
PORT=8000

# ── Compose profile control ───────────────────────────────────────────────────
# Set to "ai" to start the Ollama AI services alongside the core stack.
# Leave empty (or omit) for OCR-only mode.
# Portainer users: set this in the stack's Environment Variables screen.
#   COMPOSE_PROFILES=ai   ← enable AI
#   COMPOSE_PROFILES=     ← core only (default)
COMPOSE_PROFILES=

# Default US state used when none is detected from OCR (default: NM)
DEFAULT_STATE=NM

# PostgreSQL connection settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=titles
DB_USER=postgres
DB_PASSWORD=postgres

# Extraction provider: tesseract | ai | hybrid (default: hybrid)
# hybrid  – try AI first; fall back to Tesseract for low-confidence fields
# ai      – AI only (automatic Tesseract fallback when AI is unreachable)
# tesseract – Tesseract/regex only, no AI
EXTRACTION_PROVIDER=hybrid

# Self-hosted Ollama AI service settings (only used when COMPOSE_PROFILES=ai)
# AI_ENDPOINT is the base URL of the Ollama service (no trailing slash)
AI_ENDPOINT=http://ollama:11434
AI_MODEL=moondream
AI_TIMEOUT=60

# Base model used by the Training → "Apply to AI Model" feature when building
# the 'titles-custom' Modelfile.  Must be a real Ollama model name (never
# 'titles-custom' itself).  Defaults to AI_MODEL when not set.
# Set this explicitly if you change AI_MODEL to 'titles-custom' after training:
#   LLM_BASE_MODEL=moondream
LLM_BASE_MODEL=

# Ollama image version tag (default: latest).
# Set to a specific release tag (e.g. 0.21.1) to pin a known-good version and
# avoid unexpected upgrades.  Both the ollama and ollama-init services use this
# value, so changing it here updates both at once.
OLLAMA_VERSION=latest

# Fields with confidence below this threshold are flagged for review (0.0–1.0)
AI_CONFIDENCE_THRESHOLD=0.6
