# ── Quick start ──────────────────────────────────────────────────────────────
#
# Core only (OCR, starts immediately):
#   docker compose up
#
# With AI assistance (downloads model on first run, ~2-4 GB):
#   docker compose --profile ai up
#
# Copy this file to .env and edit values before running:
#   cp .env.example .env

# Application port (default: 8000)
PORT=8000

# Default US state used when none is detected from OCR (default: NM)
DEFAULT_STATE=NM

# PostgreSQL connection settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=titles
DB_USER=postgres
DB_PASSWORD=postgres

# Extraction provider: tesseract | ai | hybrid (default: hybrid)
# hybrid  – try AI first; fall back to Tesseract for low-confidence fields
# ai      – AI only (automatic Tesseract fallback when AI is unreachable)
# tesseract – Tesseract/regex only, no AI
EXTRACTION_PROVIDER=hybrid

# Self-hosted Ollama AI service settings (only used when --profile ai is active)
# AI_ENDPOINT is the base URL of the Ollama service (no trailing slash)
AI_ENDPOINT=http://ollama:11434
AI_MODEL=moondream
AI_TIMEOUT=60

# Fields with confidence below this threshold are flagged for review (0.0–1.0)
AI_CONFIDENCE_THRESHOLD=0.6
